{
  "name": "codeowners",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#absolute-rule"
    },
    {
      "include": "#rule"
    }
  ],
  "repository": {
    "comment": {
      "match": "(#).*$",
      "name": "comment.line.number-sign.codeowners",
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.codeowners"
        }
      }
    },
    "absolute-rule": {
      "begin": "^\\s*(/(?:[^\\s#\\\\]|\\\\.|\\\\$)*)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.codeowners",
          "patterns": [
            {
              "include": "#pattern-tokens"
            }
          ]
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#owners"
        }
      ]
    },
    "rule": {
      "begin": "^\\s*((?:[^\\s#\\\\]|\\\\.|\\\\$)+)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.type.codeowners",
          "patterns": [
            {
              "include": "#pattern-tokens"
            }
          ]
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#owners"
        }
      ]
    },
    "pattern-tokens": {
      "patterns": [
        {
          "match": "\\\\[ \\t#\\[\\]\\\\]",
          "name": "constant.character.escape.codeowners"
        },
        {
          "match": "\\\\.",
          "name": "invalid.illegal.escape.codeowners"
        },
        {
          "match": "[\\[\\]]",
          "name": "invalid.illegal.bracket.codeowners"
        },
        {
          "match": "\\*{3,}",
          "name": "invalid.illegal.wildcard.codeowners"
        },
        {
          "match": "\\*\\*|\\*|\\?",
          "name": "keyword.operator.wildcard.codeowners"
        }
      ]
    },
    "owners": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "match": "@[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)?(?=\\s|#|$)",
          "name": "storage.type.function.codeowners"
        },
        {
          "match": "[^\\s#@]+@[^\\s#@]+\\.[A-Za-z]{2,}(?=\\s|#|$)",
          "name": "storage.type.function.codeowners"
        },
        {
          "match": "[^\\s#]+",
          "name": "invalid.illegal.owner.codeowners"
        }
      ]
    }
  },
  "scopeName": "text.codeowners"
}
