#!/usr/bin/env bash
# s/download-server <vsce target>
#
# Download the gh-codeowners binary for a VS Code platform, like
# darwin-arm64, into bin/, where the extension looks for its language server.
set -euo pipefail

GH_CODEOWNERS_VERSION=v0.1.0

target=$1
case "$target" in
  darwin-arm64) asset=gh-codeowners-darwin-arm64 ;;
  darwin-x64) asset=gh-codeowners-darwin-amd64 ;;
  # The Linux binaries are static, so they run on Alpine too.
  linux-x64 | alpine-x64) asset=gh-codeowners-linux-amd64 ;;
  linux-arm64 | alpine-arm64) asset=gh-codeowners-linux-arm64 ;;
  win32-x64) asset=gh-codeowners-windows-amd64.exe ;;
  win32-arm64) asset=gh-codeowners-windows-arm64.exe ;;
  *)
    echo "No gh-codeowners binary for $target" >&2
    exit 1
    ;;
esac

exe=""
if [[ "$asset" == *.exe ]]; then
  exe=.exe
fi

cd "$(dirname "$0")/.."
rm -rf bin
mkdir bin
gh release download "$GH_CODEOWNERS_VERSION" \
  --repo chdsbd/gh-codeowners \
  --pattern "$asset" \
  --output "bin/gh-codeowners$exe"
chmod +x "bin/gh-codeowners$exe"
